<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件布局（RemoteViews 白名单控件）。

  为什么长这样：
  * RemoteViews 只支持有限控件（LinearLayout/FrameLayout/RelativeLayout/GridLayout +
    TextView/ImageView/ImageButton/Button/ProgressBar/Chronometer…）。这里**不要**用
    ConstraintLayout / RecyclerView / CardView / 自绘，否则 RemoteViews 膨胀会抛
    "Class not allowed to be inflated"。
  * 颜色一律用平台主题属性（?android:attr/textColorPrimary）或透明，不写死 #FFFFFF/#000000：
    小组件是在**桌面进程**里膨胀的，拿不到 App 的 ThemeData，写死颜色在深色桌面下会瞎。
  * 每个可点元素都各自挂 PendingIntent（在 MconnectWidgetProvider 里用
    setOnClickPendingIntent 设置），所以这里只定义 id，不写 android:onClick。
  * 所有文案都有 tools/默认值兜底，但真正的"未播放"兜底由 Kotlin 侧用
    @string/mconnect_widget_idle 填，避免首次添加组件（Dart 还没跑过）时一片空白。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mconnect_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/mconnect_widget_cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/mconnect_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/mconnect_widget_idle" />

            <TextView
                android:id="@+id/mconnect_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/mconnect_widget_open_hint" />
        </LinearLayout>

        <!-- 三个控制按钮：全部通过 HomeWidgetBackgroundIntent 回调 Dart（后台 isolate），
             这样"上一首/播放暂停/下一首"不必先打开 App。 -->
        <ImageButton
            android:id="@+id/mconnect_widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="@string/mconnect_widget_previous" />

        <ImageButton
            android:id="@+id/mconnect_widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="@string/mconnect_widget_play_pause" />

        <ImageButton
            android:id="@+id/mconnect_widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="@string/mconnect_widget_next" />
    </LinearLayout>
</LinearLayout>
